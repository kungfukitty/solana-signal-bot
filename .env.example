# Copy to .env and fill in. Never commit .env.

# https://dashboard.helius.dev  (free tier is enough)
HELIUS_API_KEY=
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Discord: Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Any long random string. Helius sends it back so the server can reject strangers.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_AUTH_SECRET=
# Where this server is reachable from the internet, ending in /helius
PUBLIC_WEBHOOK_URL=https://your-app.up.railway.app/helius

# Optional overrides (defaults shown)
# GRADING_MODEL=claude-opus-5-5
# TRIAGE_MODEL=claude-sonnet-5-5
# LOOKBACK_DAYS=30
# CLUSTER_WINDOW_MIN=30
# CLUSTER_MIN_WALLETS=2
# LARGE_BUY_MULTIPLE=2.0
# HIGH_GRADES=A,A-
# LATE_AFTER_MIN=20
# WATCHLIST_MAX=10
# DB_PATH=bot.db
